# Builds Doom (doomgeneric) to WebAssembly for the module's page: assets/doom.js and
# assets/doom.wasm, single-threaded, with no SDL and no main loop (engine/doomgeneric_ein.c).
#
#   docker buildx build --file engine/Containerfile --output type=local,dest=assets engine
#
# The local exporter writes the files on the host, so no bind mount needs to be writable.
# Run from the repository's root directory; scripts/build-engine.sh does exactly this.

# emsdk 6.0.13, the multi-platform index (linux/amd64 and linux/arm64).
FROM docker.io/emscripten/emsdk:6.0.13@sha256:fb7864e398acfda863dfcea78b8bc8adad359fa60c6a0bbeb845931de64aa68a AS build

# doomgeneric, pinned. GPL-2.0-or-later, like this module.
ARG DOOMGENERIC_COMMIT=e257a09527062bfb986b6e5e0780839b6cbd5b71
RUN git init -q /src \
  && git -C /src fetch -q --depth 1 https://github.com/ozkl/doomgeneric.git ${DOOMGENERIC_COMMIT} \
  && git -C /src checkout -q FETCH_HEAD

# The screen wipe ran as a loop of its own, which froze the page for the second it took.
COPY nonblocking-wipe.patch /src/
RUN git -C /src apply /src/nonblocking-wipe.patch

WORKDIR /src/doomgeneric
COPY doomgeneric_ein.c .

# The engine's sources: Makefile.emscripten's list without its SDL platform, music and sound.
ARG SOURCES="dummy am_map doomdef doomstat dstrings d_event d_items d_iwad d_loop d_main d_mode d_net f_finale f_wipe g_game hu_lib hu_stuff info i_cdmus i_endoom i_joystick i_scale i_sound i_system i_timer memio m_argv m_bbox m_cheat m_config m_controls m_fixed m_menu m_misc m_random p_ceilng p_doors p_enemy p_floor p_inter p_lights p_map p_maputl p_mobj p_plats p_pspr p_saveg p_setup p_sight p_spec p_switch p_telept p_tick p_user r_bsp r_data r_draw r_main r_plane r_segs r_sky r_things sha1 sounds statdump st_lib st_stuff s_sound tables v_video wi_stuff w_checksum w_file w_main w_wad z_zone w_file_stdc i_input i_video doomgeneric doomgeneric_ein"

# Two compilers at a time keep the build's memory small beside a running EiN. The glue is headed
# with Deno's ignore comments, so core's `deno fmt` and `deno lint` pass over the generated file.
ENV EMCC_CORES=2
RUN mkdir -p /out \
  && emcc -O2 -DDOOMGENERIC_RESX=320 -DDOOMGENERIC_RESY=200 -w \
    $(for name in ${SOURCES}; do echo "${name}.c"; done) \
    -o /out/doom.js \
    -sMODULARIZE=1 -sEXPORT_ES6=1 -sEXPORT_NAME=createDoom \
    -sENVIRONMENT=web \
    -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=64MB -sSTACK_SIZE=1MB \
    -sEXPORTED_FUNCTIONS=_ein_start,_ein_tick,_ein_key,_ein_screen,_ein_width,_ein_height,_ein_frames \
    -sEXPORTED_RUNTIME_METHODS=FS,ccall,HEAPU8 \
    -sFORCE_FILESYSTEM=1 \
  && { printf '%s\n' '// deno-fmt-ignore-file' '// deno-lint-ignore-file' '// Generated by engine/Containerfile with Emscripten. Do not edit.'; cat /out/doom.js; } > /out/doom.js.new \
  && mv /out/doom.js.new /out/doom.js \
  && echo "doomgeneric ${DOOMGENERIC_COMMIT} with nonblocking-wipe.patch, emsdk 6.0.13" > /out/doom-build.txt

FROM scratch
COPY --from=build /out/ /
