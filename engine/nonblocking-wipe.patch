+//
+// D_WipeStep
+//  The screen wipe without its loop, so a page that owns the main
+//  loop keeps drawing while the screen melts: doomgeneric_Tick calls
+//  this alone, running no tics, until the melt is done, as the
+//  original's blocking loop ran none either.
+//
+static boolean wiping = false;
+static int wipe_tic;
+
+static void D_WipeStep (void)
+{
+    int nowtime = I_GetTime ();
+    int tics = nowtime - wipe_tic;
+
+    if (tics <= 0)
+	return;
+    wipe_tic = nowtime;
+    if (wipe_ScreenWipe(wipe_Melt, 0, 0, SCREENWIDTH, SCREENHEIGHT, tics))
+	wiping = false;
+    I_UpdateNoBlit ();
+    M_Drawer ();                            // menu is drawn even on top of wipes
+    I_FinishUpdate ();                      // page flip or blit buffer
+}
+
