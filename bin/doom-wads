#!ts
/** doom-wads — the WADs in Doom's WAD folder and the free ones offered, as the Games page and a game's page list them. */
import type { CmdReturn, Command } from '@ein/client';
import type { GameEntry } from '@games/api';
import type { Game } from '@doom/api';
import { findWads, WADS } from '@doom/wads';

const doomWads = async (cmd: Command): CmdReturn => {
  const wads = await findWads(cmd);
  if (cmd.json) await cmd.writeJSON(wads satisfies Game[] satisfies GameEntry[]);
  else {
    for (const wad of wads) {
      if (wad.state === 'offered') await cmd.writeLn(`${wad.id}  ${wad.title}  offered, doom-fetch ${wad.id}`);
      else await cmd.writeLn(`${wad.id}  ${wad.title}  ${wad.iwad ? `on ${wad.iwad}` : wad.kind}`);
    }
  }
  return 0;
};

doomWads.spec = {
  name: 'doom-wads',
  effect: 'read' as const,
  description: `List the WADs in ${WADS}, known games first, by title, in the order they came out; then the free ones doom-fetch fetches that are not there yet`,
  args: [],
  flags: [],
  examples: ['doom-wads'],
  returns:
    'One entry per WAD. One in the folder: its id (the file\'s name), title, state installed, path, detail, size in bytes, cover (its title screen as a PNG data: URL), kind (IWAD or PWAD), and iwad (the IWAD a PWAD is played with). A WAD of a game other than Doom (Heretic, Hexen, Strife) is left out. One offered: its id, title, state offered, about and download (bytes).',
};

export default doomWads;
